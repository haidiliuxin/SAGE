SAGE_DATABASE_URL=sqlite:///./data/sage_pass.db
SAGE_UPLOAD_DIR=./data/uploads
SAGE_MAX_UPLOAD_BYTES=10485760
SAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
SAGE_HASHCAT_PATH=hashcat
SAGE_ZIP2JOHN_PATH=zip2john
SAGE_PLANNER_TYPE=mock                  # mock | rule | llm
OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 可选：OpenAI 兼容网关
SAGE_LLM_API_STYLE=responses           # responses | chat_completions
SAGE_LLM_MODEL=gpt-4.1-mini
SAGE_LLM_TEMPERATURE=0.1
SAGE_LLM_TIMEOUT_SECONDS=15
SAGE_LLM_MAX_OUTPUT_TOKENS=700
SAGE_LLM_CACHE_TTL_SECONDS=900
SAGE_LLM_CACHE_MAX_ENTRIES=256
