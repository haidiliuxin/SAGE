SAGE_DATABASE_URL=sqlite:///./data/sage_pass.db
SAGE_UPLOAD_DIR=./data/uploads
SAGE_MAX_UPLOAD_BYTES=10485760
SAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
SAGE_HASHCAT_PATH=hashcat
SAGE_HASHCAT_STREAM_BATCH_SIZE=100000
SAGE_ZIP2JOHN_PATH=zip2john
# S3 默认保持 pcfg_lite；切换 pcfg_full 时必须指向 pcfg_cracker ruleset 目录。
SAGE_PCFG_VARIANT=pcfg_lite            # pcfg_lite | pcfg_full
# SAGE_PCFG_RULESET_PATH=D:\path\to\pcfg_cracker\Rules\MyRuleset
# 可选：覆盖 S3 生成器；设置 markov 时加载独立 OMEN 模型。
# SAGE_S3_GENERATOR=markov              # pcfg_lite | pcfg_full | markov
# SAGE_MARKOV_RULESET_PATH=D:\path\to\Rules\MyRuleset\Omen
SAGE_MARKOV_ORDER=3
# S4 默认 auto：I1 使用 context，I2 使用 history，I3 使用 hybrid。
# SAGE_S4_GENERATOR=auto                # auto | context | history | hybrid
SAGE_PLANNER_TYPE=mock                  # mock | rule | llm
OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 可选：OpenAI 兼容网关
SAGE_LLM_API_STYLE=responses           # responses | chat_completions
SAGE_LLM_MODEL=gpt-4.1-mini
SAGE_LLM_TEMPERATURE=0.1
SAGE_LLM_TIMEOUT_SECONDS=15
SAGE_LLM_MAX_OUTPUT_TOKENS=700
SAGE_LLM_CACHE_TTL_SECONDS=900
SAGE_LLM_CACHE_MAX_ENTRIES=256
SAGE_FEEDBACK_MINIMUM_OBSERVATIONS=2
SAGE_FEEDBACK_MINIMUM_TASKS=2
SAGE_FEEDBACK_MAXIMUM_PATTERNS_PER_SCOPE=500
SAGE_FEEDBACK_RECENCY_HALF_LIFE_DAYS=90
# Mock 默认不进入知识库；当前内置 Mock 不产生恢复明文。
SAGE_FEEDBACK_ENABLE_MOCK=false
SAGE_SCHEDULER_TYPE=heuristic_bandit   # fixed | round_robin | heuristic_bandit | ucb | cost_aware_ucb（thompson 为预留值）
SAGE_PDF2JOHN_PATH=pdf2john       # John the Ripper pdf2john
SAGE_OFFICE2JOHN_PATH=office2john # John the Ripper office2john
SAGE_EXTRACTION_TIMEOUT_SECONDS=30
# 每次调度决策的候选上限（默认 1000：粒度细、Bandit 可在单元内重新分配预算）
SAGE_DECISION_BATCH_SIZE=1000
# 吞吐优先时可调大（例如 100000），摊薄 hashcat 进程启动开销
SAGE_HASHCAT_STREAM_BATCH_SIZE=1000
# 服务器端词表：配置后 S1 由 hashcat 直接读整本字典（原生攻击，单进程，不做候选物化）
# SAGE_WORDLIST_PATH=D:\wordlists\rockyou.txt
# 命中即停：真实破解语义，恢复目标后立即结束（也可在接口用 stop_on_hit 逐次覆盖）
SAGE_STOP_ON_HIT=false
