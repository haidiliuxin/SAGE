  "components": {
    "schemas": {
      "Body_upload_file_api_files_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "待评测目标文件"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_files_post"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ExecutionMode": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ],
        "title": "ExecutionMode"
      },
      "ExecutionRequest": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ExecutionMode",
            "default": "mock"
          },
          "candidates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100000,
            "title": "Candidates"
          },
          "hashcat_mode": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 99999.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hashcat Mode"
          },
          "timeout": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout"
          }
        },
        "type": "object",
        "title": "ExecutionRequest"
      },
      "ExecutionStarted": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "run_id",
          "status",
          "started_at"
        ],
        "title": "ExecutionStarted"
      },
      "FileCreated": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "filename",
          "content_type",
          "size",
          "sha256",
          "created_at"
        ],
        "title": "FileCreated"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PRIR": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "target_type": {
            "$ref": "#/components/schemas/TargetType"
          },
          "algorithm": {
            "type": "string",
            "title": "Algorithm",
            "default": "unknown"
          },
          "salt": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salt"
          },
          "verification_cost": {
            "$ref": "#/components/schemas/VerificationCost",
            "default": "unknown"
          },
          "context_available": {
            "type": "boolean",
            "title": "Context Available"
          },
          "candidate_space": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Space"
          },
          "time_budget": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Time Budget"
          },
          "candidate_budget": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Candidate Budget"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "default": "analyzed"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "target_type",
          "context_available",
          "time_budget",
          "candidate_budget",
          "confidence"
        ],
        "title": "PRIR"
      },
      "PlannerType": {
        "type": "string",
        "enum": [
          "mock",
          "rule",
          "llm",
          "adaptive"
        ],
        "title": "PlannerType"
      },
      "RecoveredItem": {
        "properties": {
          "target": {
            "type": "string",
            "title": "Target"
          },
          "plaintext": {
            "type": "string",
            "title": "Plaintext"
          }
        },
        "type": "object",
        "required": [
          "target",
          "plaintext"
        ],
        "title": "RecoveredItem"
      },
      "RunResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "total_time": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Time"
          },
          "total_tested": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Tested"
          },
          "total_recovered": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Recovered"
          },
          "strategy_results": {
            "items": {
              "$ref": "#/components/schemas/StrategyResult"
            },
            "type": "array",
            "title": "Strategy Results"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "title": "Finished At"
          },
          "recovered_items": {
            "items": {
              "$ref": "#/components/schemas/RecoveredItem"
            },
            "type": "array",
            "title": "Recovered Items"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "run_id",
          "status",
          "total_time",
          "total_tested",
          "total_recovered",
          "strategy_results",
          "finished_at"
        ],
        "title": "RunResult"
      },
      "RunStatus": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "current_strategy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StrategyId"
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsed_time": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Time"
          },
          "tested": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tested"
          },
          "recovered": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Recovered"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
